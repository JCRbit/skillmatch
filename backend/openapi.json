{
  "openapi": "3.1.0",
  "info": {
    "title": "SkillMatch API",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "operations"
        ],
        "summary": "Liveness probe",
        "description": "Report that the process is running and able to serve requests.\n\nThis probe performs no dependency checks, so a failing database never causes the\norchestrator to restart a healthy process. Readiness and version endpoints are added by\ntask P-05.",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status",
            "default": "ok"
          }
        },
        "type": "object",
        "title": "HealthResponse",
        "description": "Result of the liveness probe."
      }
    }
  }
}
