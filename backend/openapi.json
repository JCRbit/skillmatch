{
  "openapi": "3.1.0",
  "info": {
    "title": "SkillMatch API",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "operations"
        ],
        "summary": "Liveness probe",
        "description": "Report that the process is running and able to serve requests.\n\nThis probe performs no dependency checks, so a failing database never causes the\norchestrator to restart a healthy process. Readiness and version endpoints are added by\ntask P-05.",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/ready": {
      "get": {
        "tags": [
          "operations"
        ],
        "summary": "Readiness probe",
        "description": "Report whether this process can serve traffic.\n\nUnlike ``/health`` (liveness), this checks the dependencies the API cannot work without, so an\norchestrator can take the instance out of the load balancer without restarting it. It answers\n``503`` when a dependency is down.\n\nArgs:\n    session: Per-request database session.\n    response: Response object, used to set the status code.\n\nReturns:\n    The state of each dependency.",
        "operationId": "ready_ready_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            }
          }
        }
      }
    },
    "/version": {
      "get": {
        "tags": [
          "operations"
        ],
        "summary": "Running version",
        "description": "Report the application name, version, environment and commit that is running.\n\nArgs:\n    settings: Application settings.\n\nReturns:\n    The build identity of the process.",
        "operationId": "version_version_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VersionResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/register": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Create an account",
        "description": "Register a candidate (`talento`) or a company (`empresa`).\n\nAdministrators cannot be created here: the `admin` role is rejected. The account starts\n`active`, and the password is stored only as a scrypt hash.",
        "operationId": "register_api_v1_auth_register_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserRead"
                }
              }
            }
          },
          "409": {
            "description": "The request conflicts with the current state of the resource.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemResponse"
                }
              }
            }
          },
          "422": {
            "description": "The request body or parameters are invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Exchange credentials for an access token",
        "description": "Authenticate with email and password.\n\nReturns a short-lived bearer token together with the identity and role stored in the\ndatabase. The error is identical for an unknown email, a wrong password and an inactive\naccount.",
        "operationId": "login_api_v1_auth_login_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid or expired credentials.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemResponse"
                }
              }
            }
          },
          "422": {
            "description": "The request body or parameters are invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemResponse"
                }
              }
            }
          },
          "503": {
            "description": "The service cannot fulfil the request right now.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/me": {
      "get": {
        "tags": [
          "auth"
        ],
        "summary": "The authenticated account",
        "description": "Return the account behind the bearer token.",
        "operationId": "read_me_api_v1_auth_me_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserRead"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid or expired credentials.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "AuthenticatedUser": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "email": {
            "type": "string",
            "title": "Email"
          },
          "role": {
            "$ref": "#/components/schemas/UserRole"
          }
        },
        "type": "object",
        "required": [
          "id",
          "email",
          "role"
        ],
        "title": "AuthenticatedUser",
        "description": "Identity returned together with a token, as read from the database."
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status",
            "default": "ok"
          }
        },
        "type": "object",
        "title": "HealthResponse",
        "description": "Result of the liveness probe."
      },
      "LoginRequest": {
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 254,
            "minLength": 3,
            "title": "Email"
          },
          "password": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Password"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "title": "LoginRequest",
        "description": "Body of ``POST /auth/login``.\n\nThere is deliberately no ``role`` field: the role always comes from the stored account."
      },
      "ProblemResponse": {
        "properties": {
          "type": {
            "type": "string",
            "title": "Type",
            "description": "Always `about:blank`."
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "status": {
            "type": "integer",
            "title": "Status"
          },
          "detail": {
            "type": "string",
            "title": "Detail"
          },
          "code": {
            "type": "string",
            "title": "Code",
            "description": "Stable machine-readable error code."
          },
          "instance": {
            "type": "string",
            "title": "Instance",
            "description": "Path of the request that failed."
          },
          "errors": {
            "anyOf": [
              {
                "items": {
                  "additionalProperties": true,
                  "type": "object"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Errors",
            "description": "Field-level problems of a validation error."
          }
        },
        "type": "object",
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "code",
          "instance"
        ],
        "title": "ProblemResponse",
        "description": "RFC 9457 problem details, as returned for every error."
      },
      "PublicRole": {
        "type": "string",
        "enum": [
          "talento",
          "empresa"
        ],
        "title": "PublicRole",
        "description": "Roles that may be chosen at public registration.\n\n``ADMIN`` is intentionally absent: administrators are never self-service. Listing only the\ntwo public roles here also makes the OpenAPI document say so."
      },
      "ReadinessCheck": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "unavailable"
            ],
            "title": "Status",
            "default": "ok"
          }
        },
        "type": "object",
        "title": "ReadinessCheck",
        "description": "Result of a single readiness check."
      },
      "ReadinessResponse": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "unavailable"
            ],
            "title": "Status"
          },
          "checks": {
            "additionalProperties": {
              "$ref": "#/components/schemas/ReadinessCheck"
            },
            "type": "object",
            "title": "Checks"
          }
        },
        "type": "object",
        "required": [
          "status",
          "checks"
        ],
        "title": "ReadinessResponse",
        "description": "Result of the readiness probe."
      },
      "RegisterRequest": {
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 254,
            "minLength": 3,
            "title": "Email"
          },
          "password": {
            "type": "string",
            "maxLength": 128,
            "minLength": 12,
            "title": "Password",
            "description": "At least 12 characters; no composition rules."
          },
          "role": {
            "$ref": "#/components/schemas/PublicRole",
            "description": "`talento` (candidate) or `empresa` (company)."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "email",
          "password",
          "role"
        ],
        "title": "RegisterRequest",
        "description": "Body of ``POST /auth/register``."
      },
      "TokenResponse": {
        "properties": {
          "access_token": {
            "type": "string",
            "title": "Access Token"
          },
          "token_type": {
            "type": "string",
            "const": "bearer",
            "title": "Token Type",
            "default": "bearer"
          },
          "expires_in": {
            "type": "integer",
            "title": "Expires In",
            "description": "Lifetime of the token in seconds."
          },
          "user": {
            "$ref": "#/components/schemas/AuthenticatedUser"
          }
        },
        "type": "object",
        "required": [
          "access_token",
          "expires_in",
          "user"
        ],
        "title": "TokenResponse",
        "description": "Result of a successful login."
      },
      "UserRead": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "email": {
            "type": "string",
            "title": "Email"
          },
          "role": {
            "$ref": "#/components/schemas/UserRole"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "email",
          "role",
          "status",
          "created_at"
        ],
        "title": "UserRead",
        "description": "Public representation of an account. Never includes the password hash."
      },
      "UserRole": {
        "type": "string",
        "enum": [
          "talento",
          "empresa",
          "admin"
        ],
        "title": "UserRole",
        "description": "Possible roles a user can have in the platform."
      },
      "VersionResponse": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "version": {
            "type": "string",
            "title": "Version"
          },
          "environment": {
            "type": "string",
            "title": "Environment"
          },
          "git_sha": {
            "type": "string",
            "title": "Git Sha"
          }
        },
        "type": "object",
        "required": [
          "name",
          "version",
          "environment",
          "git_sha"
        ],
        "title": "VersionResponse",
        "description": "Code that is running, for traceability."
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
