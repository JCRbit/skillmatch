# Copy to .env locally; do not commit real .env. Use synthetic/dev credentials only.
APP_ENV=local
APP_NAME=SkillMatch
LOG_LEVEL=INFO

# PostgreSQL (replace local password)
POSTGRES_DB=skillmatch
POSTGRES_USER=skillmatch
POSTGRES_PASSWORD=change-me-local-only
DATABASE_URL=postgresql+psycopg://skillmatch:change-me-local-only@localhost:5432/skillmatch

# Qdrant - local dev only; do not expose without auth/network restrictions
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=profiles_and_jobs_dev

# Redis/ARQ only when background jobs are enabled
REDIS_URL=redis://localhost:6379/0

# Optional providers — enable only after PO/privacy review and local secret setup
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-m3
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=

# GitHub API token only in local secret store/.env when approved; never paste into agent prompts
GITHUB_TOKEN=

# Auth/session secrets: generate with a secure random generator; never use this example in production
APP_SECRET_KEY=change-me-local-only

# Do not point this at production during audit/development
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=skillmatch-dev
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
